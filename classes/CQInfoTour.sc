// One authored learning path: introductions precede the player's actions.
// Stable lesson identities keep cable entry, cues and tests independent of numbering.
CQInfoTour {
	*label { ^"basics & first loop" }
	*count { ^this.steps.size }
	*indexOf { |id| ^this.steps.detectIndex { |step| step[\id] == id } ? 0 }
	*step { |index|
		var steps = this.steps, n = index.asInteger.clip(0, steps.size - 1);
		var result = steps[n].copy;
		result[\title] = this.label ++ " / " ++ (n + 1) ++ " of " ++ steps.size ++ " / " ++ result[\title];
		^result
	}
	*items { |index| var step = this.step(index); ^step[\items] ++ (step[\detailItems] ? []) }
	*refs { |index| ^this.items(index).collect { |item| item[3] }.flatten }
	*cueRefs { |index|
		var step = this.step(index);
		^if(step[\concept] == true) { [] } { step[\cues] ? this.refs(index) }
	}
	*steps {
		^[
			(id: \overview, title: "sound into memory", side: 0, concept: true,
				gesture: "Yönpuoli turns incoming sound into repeating memories, drones and texture.",
				body: "Birds play audio files. The spiral Cocos capture and reshape sound. Roots select and colour live inputs or files; each bird also feeds its own Coco directly.",
				detail: "We will build a loop, then animate it. Hover pictures to find their parts. Use next / right arrow to continue. Fresh session below returns the instrument, including loop contents, to its starting setup.",
				items: [[\bird, "birds / files", nil, CQInkInfo.symbolRefs(\bird)],
					[\coco, "Cocos / memory", nil, CQInkInfo.symbolRefs(\coco)],
					[\root, "roots / inputs", nil, CQInkInfo.symbolRefs(\root)]]),
			(id: \load, title: "find a sound", side: 0,
				gesture: "The left bird is our source. Click it and choose an audio file.",
				body: "Its filename appears below the wings. You can also drop a file onto the bird. It repeats the file, ready to feed the left memory.",
				detail: "We will listen to the source first, then capture it. Keep your listening level low.",
				items: [[\bird, "left bird / load", \tap, [[\bird, 0]]]]),
			(id: \preview, title: "listen before recording", side: 0,
				gesture: "Master dry previews sources before memory; vol sets the overall listening level.",
				body: "Raise dry gently. You should hear the file looping directly. If silent, check vol and that PANIC is off. Space mutes / resumes at any time.",
				detail: "Dry is separate from the Coco's volume. The session REC button records the final stereo output to a file; the Coco hearts record into loop memory.",
				items: [[\dry, "Master dry / preview", \up, [[\master, \masterDry]]]]),
			(id: \coco, title: "meet the Coco", side: 0, concept: true,
				gesture: "A Coco is a short circular sound memory: it reads the same loop again and again.",
				body: "Its heart controls writing: hollow admits new sound; sealed red keeps the captured loop. The spiral changes reading speed and tone. Its moving ball is the playhead, showing where the memory is being read.",
				detail: "The outer shoreline sets loop volume. Below the shell, crescents shape incoming sound and modulation; we will learn them one at a time. Coco 1 is on the left, Coco 2 on the right.",
				items: [[\wind, "spiral / time", nil, [[\param, \coco1Speed]]],
					[\heartOpen, "heart / writing", nil, [[\param, \coco1Hold]]],
					[\shore, "shore / volume", nil, [[\param, \coco1Level]]]]),
			(id: \write, title: "write into Coco 1", side: 0,
				gesture: "Click the left heart until it is hollow.",
				body: "The left bird now writes into this memory. Let the file pass through for at least one full lap of the moving playhead.",
				detail: "New sound replaces the loop as it goes around. The starting settings already admit the bird; no cable or input adjustment is needed yet.",
				items: [[\heartOpen, "left heart / write", \tap, [[\param, \coco1Hold]]]]),
			(id: \hold, title: "keep the loop", side: 0,
				gesture: "Seal the left heart red, then lower Master dry to zero.",
				body: "Now you hear the memories without the original file on top. Coco 1 keeps repeating what you captured.",
				detail: "Drag its left outer shoreline up / down to balance the loop volume. Coco 2 still contains its startup noise; we will let that fade shortly.",
				items: [[\heartClosed, "seal / hold", \tap, [[\param, \coco1Hold]]],
					[\shore, "loop level", \up, [[\param, \coco1Level]]],
					[\dry, "Master dry", \down, [[\master, \masterDry]]]]),
			(id: \time, title: "reshape time", side: 0,
				gesture: "The spiral sets speed; the chevron below its mouth reverses reading direction.",
				body: "Wind the left spiral. Slower lowers pitch, lengthens the loop and roughens its texture. Faster raises pitch, shortens the loop and makes it brighter. The short line across the groove marks speed.",
				detail: "The ball keeps showing the reading position. Try changing direction a few times with the chevron. Keep the heart sealed to explore the same sound.",
				items: [[\wind, "speed / playhead", \wind, [[\param, \coco1Speed]]],
					[\flip, "reverse", \tap, [[\param, \coco1Flip]]]]),
			(id: \castles, title: "where motion comes from", side: 0, concept: true,
				gesture: "The five castles are linked oscillators. They can move other controls for you.",
				body: "Orange triangle outputs flow continuously. Grey outputs step or track another castle. Slow signals animate a parameter; fast signals can become texture or audible tones.",
				detail: "The central eye shapes all five: up/down sets their speed; sideways sets chaos. Watch their motion change. We will use the top castle to animate our loop next.",
				items: [[\castle, "castles / motion", nil, CQInkInfo.symbolRefs(\castle)],
					[\eye, "eye / shared motion", nil, CQInkInfo.symbolRefs(\eye)]]),
			(id: \ports, title: "sound paths & control cables", side: 0, concept: true,
				gesture: "Sound has built-in paths. Patch cables move controls instead of rerouting audible sound.",
				body: "Solid output dots send signals; hollow input rings receive them. A cable connects an output to an input, letting one part influence another.",
				detail: "For audio, Q inlets admit castle tones into memory; the curved bridge feeds each Coco into the other. Their valves set the flow. Those audio paths are separate from the control cable we will make next.",
				items: [[\output, "solid output", nil, CQInkInfo.symbolRefs(\output)],
					[\input, "hollow input", nil, CQInkInfo.symbolRefs(\input)],
					[\gill, "Q / audio in", nil, CQInkInfo.symbolRefs(\gill)],
					[\bridge, "Coco bridge", nil, CQInkInfo.symbolRefs(\bridge)]]),
			(id: \connect, title: "make a cable", side: 0,
				gesture: "Left-drag makes a positive orange cable; right-drag makes a negative blue one that inverts the motion.",
				body: "Left-drag the top castle's upper-right orange dot toward Coco 1's purple speed socket. Before release, wheel or Z / X sets strength; Esc cancels. Then release on the hollow ring to plant it.",
				detail: "No pitch movement yet? SP.AF, the leftmost crescent below Coco 1, controls this input's influence on speed. It is still at zero, so the cable changes no pitch. We will raise it next.",
				items: [[\output, "top triangle out", \tap, [[\endpoint, \tri1]]],
					[\connect, "Coco 1 / speed in", \across, [[\endpoint, \coco1_spaf]]]]),
			(id: \depth, title: "hear the influence", side: 0,
				gesture: "The leftmost crescent, SP.AF, sets this speed input's depth.",
				body: "Raise SP.AF gently. Wheel over the cable for strength; Ctrl gives fine steps. Its thickness and midpoint wheel show weight.",
				detail: "Master depth scales all cables; keep it full. Move the eye up/down for castle speed, left/right for chaos.",
				items: [[\spaf, "leftmost / SP.AF", \up, [[\param, \coco1Spaf]]],
					[\weights, "cable / strength", \wheel, [[\cable, \tri1, \coco1_spaf]]]],
				detailItems: [[\depth, "Master depth", nil, [[\master, \patchDepth]]],
					[\eye, "eye / motion", \down, [[\eye]]]]),
			(id: \edit, title: "change a connection", side: 0,
				gesture: "You can reverse, move or remove a planted cable without starting the patch again.",
				body: "Alt-click reverses polarity. Drag the cable's seated end to another input to move it. Right-click removes it. Ctrl+Z undoes an edit; Ctrl+X restores it.",
				detail: "Try Alt-clicking your speed cable and listen to the inverted movement. Undo once to keep the original connection for the next step. These keys restore patch edits, not overwritten loop audio.",
				items: [[\negative, "Alt-click / reverse", \tap, [[\cable, \tri1, \coco1_spaf]]],
					[\moveCable, "seated end / move", nil, [[\endpoint, \coco1_spaf]]]]),
			(id: \flip, title: "trigger direction changes", side: 0,
				gesture: "The flip input reverses direction once on each rising trigger.",
				body: "Left-drag the same top triangle output to Coco 1's flip input. Wheel this orange cable to full strength; keep Master depth fully up.",
				detail: "Each trigger turns forward into reverse, or reverse into forward. Slow the castles with the eye to hear separate turns; lower SP.AF if pitch movement hides them. Right-click the flip cable for steady direction again.",
				items: [[\flipInput, "flip input", \across, [[\endpoint, \coco1_flip]]],
					[\output, "same triangle", \tap, [[\endpoint, \tri1]]],
					[\fullWeight, "full strength", \wheel, [[\cable, \tri1, \coco1_flip]]]]),
			(id: \rightOpen, title: "open the right memory", side: 1,
				gesture: "Coco 2 works like Coco 1. Click its heart until it is hollow, and leave it open.",
				body: "With no right-hand sample loaded, let the playhead make a few laps. At the starting settings, the old noise fades each time around. A faint texture may remain.",
				detail: "The open heart keeps writing, ready for the right bird. At slow speed each lap takes longer. Coco 1 can keep playing throughout.",
				items: [[\heartOpen, "right heart / open", \tap, [[\param, \coco2Hold]], 1],
					[\wind, "a few laps", \wind, [[\param, \coco2Speed]], 1]]),
			(id: \rightBird, title: "send the right bird flying", side: 1,
				gesture: "Pulling and releasing a bird loads a random sample from its folder or the sample library.",
				body: "Try it with the right bird. It springs back, and Coco 2's open heart records the new sound immediately. Pull again to try another sample.",
				detail: "If no file is available, click the bird and choose one. Give the memory a lap to fill. Leave its heart open for the next experiments; dry can stay at zero.",
				items: [[\bird, "right bird / pull", \across, [[\bird, 1]], 1],
					[\heartOpen, "still writing", \tap, [[\param, \coco2Hold]], 1]]),
			(id: \input, title: "new sound / Input", side: 1,
				gesture: "Input is the middle crescent below Coco 2. It admits new sound into the open memory.",
				body: "Drag this crescent down to let less bird sound enter; bring it back up to hear new material join the loop. This changes what gets written, not the final listening volume.",
				detail: "Restore Input to a comfortable level and leave the heart open. Next we will use the separate crescent immediately to its right.",
				items: [[\inputBank, "middle crescent / Input", \up, [[\param, \coco2In]], 1]]),
			(id: \feedback, title: "returning sound / Feedback", side: 1,
				gesture: "Feedback is the rightmost crescent below Coco 2. It returns old memory into the next pass.",
				body: "Raise this crescent slowly with the heart open. Low settings let old sound fade; unity means a full-strength return. Above unity, it builds into the converter's distortion.",
				detail: "Listen to successive laps change, then bring Feedback below unity again. Keep the heart open for the next step.",
				items: [[\feedbackBank, "rightmost crescent / Feedback", \up, [[\param, \coco2Fb]], 1]]),
			(id: \dust, title: "write a little dust", side: 1,
				gesture: "The faint veil beside the Coco adds dust: noise and chip-like debris written into memory.",
				body: "Drag Coco 2's veil up for more dust, down for less. Left favours a steady hiss; right favours sparse crackles. Grain blends these two noise sources, not sample-grain size.",
				detail: "To hear the contrast, lower Input and Feedback, leave the heart open and compare left/right after a full lap. A loud sample can mask it. Then restore Input, lower dust and keep writing.",
				items: [[\dust, "amount / up-down", \up, [[\dust, 1]], 1],
					[\dust, "grain / left-right", \across, [[\dust, 1]], 1]]),
			(id: \cross, title: "connect the two Cocos", side: 2,
				gesture: "A Coco's grey output sends its recorded waveform as modulation. It can move the other Coco's controls.",
				body: "Drag Coco 1's grey output dot to Coco 2's purple speed input. Raise Coco 2's SP.AF and the new cable's strength gradually. Fast waveforms add roughness rather than a slow wobble.",
				detail: "One output can feed several inputs; several outputs can share an input and their influences add. Keep this cable: next we will reshape the source feeding it.",
				items: [[\cocoOutput, "Coco 1 / grey out", \tap, [[\endpoint, \coco1]]],
					[\spaf, "Coco 2 / speed in", \up, [[\endpoint, \coco2_spaf], [\param, \coco2Spaf]], 1]]),
			(id: \crossListen, title: "one memory moves the other", side: 2,
				gesture: "Wind Coco 1's spiral while listening to Coco 2.",
				body: "You are reshaping both the left sound and the waveform driving the right speed. Coco 2's SP.AF sets how much of that movement reaches it; zero removes the influence.",
				detail: "Use the right shoreline to bring Coco 2 forward in the mix. Compare small and larger SP.AF settings, then leave a subtle amount for the next step.",
				items: [[\wind, "Coco 1 / source", \wind, [[\param, \coco1Speed]]],
					[\spaf, "Coco 2 / depth", \up, [[\param, \coco2Spaf]], 1],
					[\shore, "Coco 2 / level", \up, [[\param, \coco2Level]], 1]]),
			(id: \record, title: "let a castle hold the pen", side: 1,
				gesture: "Record is a gate: with the heart open, high pauses writing and low resumes it.",
				body: "Left-drag the top triangle output to Coco 2's red record socket. Raise this cable to full strength. Hear fragments held and released while the Cocos stay connected.",
				detail: "Unlike flip's trigger, record follows the whole high interval. Clicking the heart swaps which part writes. The eye changes the rhythm. Right-click the record cable to remove it.",
				items: [[\output, "top triangle", \tap, [[\endpoint, \tri1]]],
					[\recordInput, "right record in", \across, [[\endpoint, \coco2_record]], 1]]),
			(id: \moon, title: "grow a new patch", side: 1,
				gesture: "The moon sows a random patch: new connections and related settings. Fullness controls how much detail it adds.",
				body: "Drag the moon sideways to choose its fullness, then tap it. Compare a small crescent and a fuller moon. Ctrl+Z undoes the patch; Ctrl+X restores the same one.",
				detail: "Your loop audio keeps evolving through these changes. Undo restores settings and cables, not overwritten memory.",
				items: [[\moon, "fullness / sideways", \across, [[\moon]]],
					[\moon, "tap / sow", \tap, [[\moon]]]]),
			(id: \explore, title: "keep exploring", side: 1, concept: true,
				gesture: "You now have two memories, moving controls and several ways to reshape their sound.",
				body: "Another voice awaits: each Coco's yellow calyx adds Organ, a tone layer that follows its speed. Roots offer more input choices and colour. Drawer holds setup, presets and saved memories.",
				detail: "Choose organ & advanced at the top left for a new patch built from scratch: living tones, roots, audio bridges and patch memories. Or close to inspect any shape. Esc or info returns to playing; Shortcuts lists the keys.",
				items: [[\organ, "yellow calyx / Organ", nil, CQInkInfo.symbolRefs(\organ)],
					[\root, "roots / source colour", nil, CQInkInfo.symbolRefs(\root)]])
		]
	}
}
