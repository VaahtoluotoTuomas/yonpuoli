// A second, player-built patch. Shares the guide renderer and navigation;
// reading a lesson never performs its musical actions.
CQInfoAdvanced : CQInfoTour {
	*label { ^"organ & advanced" }
	*steps {
		^[
			(id: \overview, title: "a voice without a sample", side: 0, concept: true,
				gesture: "Build a breathing Organ voice, then give it a partner made from sound and memory.",
				body: "Organ follows the Coco's clock without needing recorded audio. Roots can turn a file's loudness into motion. Later we will add castle tones, an audio bridge and two patch memories.",
				detail: "Start with fresh session below, then reset now. This replaces unsaved sound and settings; saved files stay. Keep your listening level low. You play each step yourself; pictures only locate controls.",
				items: [[\organ, "Organ / voice", nil, [[\param, \coco1Organ]]],
					[\root, "roots / response", nil, CQInkInfo.symbolRefs(\root)],
					[\seedStates, "patch memories", nil, [[\seed, 0], [\seed, 2]]]]),
			(id: \prepare, title: "make room for Organ", side: 2,
				gesture: "First remove the startup noise from our listening path.",
				body: "Lower Coco 2's outer shoreline all the way to mute the right voice. On Coco 1, lower the middle Input and rightmost Feedback crescents to zero.",
				detail: "Input admits new sound; Feedback returns old memory. Closing both lets us erase the left loop cleanly next. Leave Coco 1's shoreline at its starting level; Master dry stays at zero.",
				items: [[\shore, "right / mute", \down, [[\param, \coco2Level]], 1],
					[\inputCrescent, "Input / zero", \down, [[\param, \coco1In]]],
					[\feedback, "Feedback / zero", \down, [[\param, \coco1Fb]]]]),
			(id: \clear, title: "clear the left memory", side: 0,
				gesture: "Drag Coco 1's dust veil down to zero, then open its heart.",
				body: "Let the playhead complete a full lap, then seal the heart red. With Input, Feedback and Dust at zero, the old loop is replaced by silence.",
				detail: "At the starting speed a lap takes about six seconds. The right voice is still muted. We now have space to hear Organ by itself; no sample needs loading yet.",
				items: [[\dust, "left dust / zero", \down, [[\dust, 0]]],
					[\heartOpen, "open, then seal", \tap, [[\param, \coco1Hold]]]]),
			(id: \organ, title: "wake the yellow voice", side: 0,
				gesture: "Organ is a stack of square-wave tones tied to this Coco's speed.",
				body: "Drag up on the yellow calyx around Coco 1's yellow dot. Its fill controls the audible Organ level. Grab the curved flesh, not the central output dot.",
				detail: "Wind the spiral to tune it: faster is higher, slower is lower. The sealed loop can stay silent while Organ sings. The shoreline sets the whole Coco's level, including Organ.",
				items: [[\organ, "calyx / level", \up, [[\param, \coco1Organ]]],
					[\wind, "spiral / pitch", \wind, [[\param, \coco1Speed]]]]),
			(id: \breathe, title: "give the tone a pulse", side: 0,
				gesture: "The hollow yellow Organ input moves the calyx level. The hand setting is its resting level.",
				body: "Set the calyx low. Left-drag the top castle's orange output to Coco 1's yellow input ring. Wheel the cable down to a gentle influence, then listen to the tone swell and fade.",
				detail: "Use the eye up/down until the top castle moves every second or two. Keep sideways chaos low for a clear pulse. The solid calyx fill stays where your hand left it; its outer light shows modulation.",
				items: [[\organInput, "Organ input", nil, [[\endpoint, \coco1_organ]]],
					[\output, "top triangle", \tap, [[\endpoint, \tri1]]],
					[\eye, "eye / pulse rate", \up, [[\eye]]]]),
			(id: \steps, title: "give the pulse a melody", side: 0,
				gesture: "A castle's grey output samples another castle, making steps or held glides.",
				body: "Connect the top castle's upper-left grey dot to Coco 1's purple speed input. Raise the leftmost SP.AF crescent only a little. Organ now follows that changing pitch.",
				detail: "Keep the orange Organ-level cable too: the same castle now shapes rhythm and pitch through different outputs. Use a light cable weight for small intervals. This is wandering pitch, not a scale quantizer.",
				items: [[\castleOutput, "top / grey out", \tap, [[\endpoint, \cas1]]],
					[\spaf, "left / pitch depth", \up, [[\endpoint, \coco1_spaf], [\param, \coco1Spaf]]]]),
			(id: \spesal, title: "change who listens to whom", side: 0,
				gesture: "A castle tap steps its Spesal state: which partner it reads, and whether it samples or tracks.",
				body: "Tap the top castle's body a few times. Listen to the grey-output melody change. Its inner marks show the chosen relationship; hovering reveals its partner.",
				detail: "A quick tap changes the relationship. A longer radial drag instead changes its audio send, which we will use later. Leave a pattern you like and keep both cables.",
				items: [[\castle, "top castle / tap", \tap, [[\castle, 0]]]]),
			(id: \rootSource, title: "a file takes root", side: 2,
				gesture: "Roots select a source and colour it before it enters the Coco above them.",
				body: "Load a rhythmic file into the left bird. On the right root, hover its strands to find deck a, then click that strand. A selected strand is brighter; clicking it again chooses none.",
				detail: "This sends the left bird through root B into Coco 2. Coco 1's Input is still zero, so its own direct bird feed stays out of the Organ voice. The right bird can remain empty; no microphone is needed.",
				items: [[\bird, "left bird / load", \tap, [[\bird, 0]]],
					[\root, "right root / deck a", \tap, [[\source, 1, \deckA]], 1]]),
			(id: \rootCapture, title: "hear the rooted sound", side: 1,
				gesture: "The right heart must be open to hear new root material enter its memory.",
				body: "Lower Coco 2's dust veil to zero and open its heart. Its default Input and Feedback already admit new sound and let the old startup noise fade. Wait a few laps, then raise its shoreline gently.",
				detail: "You now hear the rhythmic file beside the left Organ. Keep the right heart open: the root changes next will be written into this loop. Master dry stays at zero.",
				items: [[\dust, "right dust / zero", \down, [[\dust, 1]], 1],
					[\heartOpen, "right / writing", \tap, [[\param, \coco2Hold]], 1],
					[\shore, "right / listen", \up, [[\param, \coco2Level]], 1]]),
			(id: \rootTone, title: "knead the root", side: 1,
				gesture: "The root's two-lobed knot has two gestures. Each drag locks to its first direction.",
				body: "Drag the right knot up/down for Drive: more pressure adds fuzz and can raise level. Release, then drag left/right for Bias: asymmetry changes the harmonic colour.",
				detail: "Listen over a loop lap while the heart writes. Adjust the right shoreline if it gets louder. Leave a moderate Drive with clear gaps between hits; we will use those changes in loudness as a control signal.",
				items: [[\rootKnot, "Drive / up-down", \up, [[\preamp, 1]], 1],
					[\rootKnot, "Bias / left-right", \across, [[\preamp, 1]], 1]]),
			(id: \birdRate, title: "move the source rhythm", side: 2,
				gesture: "The bird's arrow socket changes file playback rate, before the sound reaches the root or memory.",
				body: "Try a light cable from the top castle's orange output to the left bird's rate input. The file accelerates and slows; Coco 2 records that changing rhythm.",
				detail: "This moves the incoming file; winding a Coco moves what is already in memory. Right-click this rate cable to return to the bird's normal speed before the next step.",
				items: [[\output, "top triangle", \tap, [[\endpoint, \tri1]]],
					[\rateInput, "left bird / rate", \across, [[\endpoint, \deckA_rate]]]]),
			(id: \envelope, title: "let the file play Organ", side: 2,
				gesture: "The root's green output follows loudness: a strong hit lifts it; silence lets it fall.",
				body: "Remove the orange triangle cable from Coco 1's Organ input. Lower the left calyx to zero. Connect the right root's green dot to that same yellow input, starting with a light positive cable.",
				detail: "The file now opens Organ on its hits, while the grey castle cable keeps choosing pitch. This envelope comes after the root's Drive and Bias. Increase cable weight if the pulse is too faint.",
				items: [[\envelope, "right root / env", \tap, [[\endpoint, \envB]], 1],
					[\organInput, "left Organ input", \across, [[\endpoint, \coco1_organ]]]]),
			(id: \duck, title: "make room for each hit", side: 1,
				gesture: "A negative cable can close a gain input as its source gets stronger.",
				body: "Raise Coco 2's Feedback toward its amber region. Right-drag the same green root output to its Feedback input. Adjust the blue cable until new hits push old repeats back, with tails returning in the gaps.",
				detail: "The Feedback hand sets the resting return; this cable subtracts from it. Remove the blue cable after comparing. Keep the root-to-Organ cable: the rhythmic voice remains part of our patch.",
				items: [[\feedbackBank, "right / Feedback", \up, [[\param, \coco2Fb]], 1],
					[\feedbackInput, "Feedback input", \across, [[\endpoint, \coco2_fbVca]], 1]]),
			(id: \dynamics, title: "the paired arcs", side: 1,
				gesture: "The paired arcs under Input and Feedback are dynamics switches: off, gate, then duck.",
				body: "Try the pair under Feedback. Gate suppresses quiet returns; duck lowers old memory when new input is strong. The pair under Input does the reverse: its duck listens to feedback.",
				detail: "Tap cycles the three shapes. Compare while the right heart writes, then return both to their open, off shape and lower Feedback below unity. These shape the writing paths; they are not output mutes.",
				items: [[\dolby, "under Feedback", \tap, [[\param, \coco2DolbyFb]], 1],
					[\dolby, "under Input", nil, [[\param, \coco2DolbyIn]], 1]]),
			(id: \punch, title: "hold, then borrow a moment", side: 1,
				gesture: "The heart also has a momentary action: hold the right mouse button to invert its current writing state.",
				body: "Seal the right heart red. Right-press and hold it to let a little new file sound into the frozen loop; release to seal it again.",
				detail: "A left tap stays switched; a right press lasts only while held. If the heart starts open, the same press temporarily freezes it. Keep the loop sealed for the next rhythmic experiment.",
				items: [[\heartClosed, "seal / left tap", \tap, [[\param, \coco2Hold]], 1],
					[\heartOpen, "right hold / punch", \tap, [[\param, \coco2Hold]], 1]]),
			(id: \skip, title: "restart a fragment", side: 1,
				gesture: "Skip jumps the playhead to the start of memory; it does not reverse direction.",
				body: "Tap the little cross below Coco 2's direction chevron. Then connect the top triangle output to its skip input at full positive strength. Each rising trigger restarts the same fragment.",
				detail: "Use the eye's vertical motion for the restart rhythm and the right spiral for the fragment's pitch. Remove the skip cable before continuing, so the whole memory can be written again.",
				items: [[\skip, "skip / restart", \tap, [[\skip, 1]], 1],
					[\skipInput, "right skip input", \across, [[\endpoint, \coco2_skip]], 1]]),
			(id: \castleSound, title: "hear a castle as sound", side: 0,
				gesture: "Each castle's lower ripple chooses slow, medium or audio range. Its inward pull opens an audio send.",
				body: "Find castle 5 at the upper left of the ring. Its dense ripple is the audio range. Try the three ripple shapes, then return to the dense one. Pull its body gently toward the eye to open its send.",
				detail: "Sending alone is not audible: the receiving Coco's Q valve must also open. Keep the top castle slow for our Organ melody. Both castles still belong to the eye's shared motion.",
				items: [[\range, "castle 5 / range", \tap, [[\param, \c5Range]], 4],
					[\castle, "castle 5 / send", \inward, [[\castle, 4]], 4]]),
			(id: \qCapture, title: "let castle tones enter", side: 1,
				cues: [[\param, \coco2SlotQ], [\param, \coco2Hold]],
				gesture: "The Q gill admits the castle audio mix into this Coco's input, alongside its root.",
				body: "Open the right heart. Raise Coco 2's amber Q gill a little and listen over a lap. Castle 5's tone joins the file; too much pushes both through the converter's distortion.",
				detail: "The castle send chooses what enters the shared mix; this gill chooses how much reaches Coco 2. Its hollow amber input can animate the valve. Leave a small audible amount and keep writing.",
				items: [[\gill, "right / Q audio", \up, [[\param, \coco2SlotQ], [\endpoint, \coco2_slotQ]], 1],
					[\heartOpen, "right / writing", \tap, [[\param, \coco2Hold]], 1]]),
			(id: \organFm, title: "Organ becomes a modulator", side: 0,
				gesture: "The solid yellow dot sends Organ's fast waveform, even when its audible calyx level is zero.",
				body: "Patch Coco 1's yellow dot to castle 5's blue wave-marked FM input. Start with a light cable. Fast pitch modulation roughens the castle tone now passing through Coco 2's Q inlet.",
				detail: "Wind the left spiral: it changes both the Organ pitch and the waveform bending castle 5. The right memory captures the result. Keep this cable subtle so the original pulse is still recognisable.",
				items: [[\organOutput, "left / yellow out", \tap, [[\endpoint, \org1]]],
					[\fmInput, "castle 5 / FM", \across, [[\endpoint, \castle5_fm]], 4]]),
			(id: \bridge, title: "print the other voice", side: 1,
				cues: [[\param, \coco2SlotX], [\param, \coco2Hold]],
				gesture: "The two curved bridge lanes carry audio. The valve at a Coco receives the opposite voice.",
				body: "Raise the bridge valve above Coco 2 gently. It now records Coco 1's audible Organ alongside the root and Q tones. Its hollow grey input can modulate that flow.",
				detail: "This carries sound; our earlier yellow-to-FM cable changes a control. Leave the left bridge valve closed to keep one clear direction. After a few laps, seal the right heart to capture the combined texture.",
				items: [[\bridge, "bridge / audio", nil, CQInkInfo.symbolRefs(\bridge)],
					[\bridgeValve, "right / receive", \up, [[\param, \coco2SlotX], [\endpoint, \coco2_slotX]], 1],
					[\heartClosed, "right / capture", \tap, [[\param, \coco2Hold]], 1]]),
			(id: \store, title: "keep a patch memory", side: 2,
				gesture: "The four little seeds remember cables and their weights. Knob settings and loop audio stay outside them.",
				body: "Shift-click the upper-left seed to store this patch. Its open husk becomes a filled kernel. An ordinary click on a filled seed recalls it; right-click clears it.",
				detail: "We have a root-driven Organ and a held composite memory. Keep both sounds playing. The seed will let us return to these connections after making a second variation.",
				items: [[\seedStates, "upper-left / store", \tap, [[\seed, 0]]]]),
			(id: \variant, title: "make a second shore", side: 2,
				gesture: "Make a gentler variation by changing cable weights, leaving the hand controls alone.",
				body: "Wheel down the grey castle cable into Coco 1's speed input for smaller pitch changes. Soften the green root-to-Organ cable too. Shift-click the lower-left seed to store this second patch.",
				detail: "Click the two filled seeds to compare the Organ's pitch movement and pulse depth. Only cables return; controls and recorded sound stay as they are. Leave both seeds filled for the next page.",
				items: [[\weights, "cables / softer", \wheel, [[\endpoint, \coco1_spaf], [\endpoint, \coco1_organ]]],
					[\seedStates, "lower-left / store", \tap, [[\seed, 2]]]]),
			(id: \blend, title: "travel between memories", side: 2,
				gesture: "The small gill below the castles opens Tide: empty water becomes a patch-blending surface.",
				body: "Click the gill or press Tab, then drag in empty water outside this card. Move toward your upper-left and lower-left seeds to blend their cable weights.",
				detail: "Left-drag keeps the result; right-drag returns when released. Bodies and sockets still work. Click the gill or press Tab again to leave Tide. Stored seeds stay intact.",
				items: [[\tideFocus, "gill / Tide on-off", \tap, [[\tideGate]]],
					[\tideBlend, "water / blend", nil, [[\seed, 0], [\seed, 2]]]]),
			(id: \breed, title: "breed a third possibility", side: 2,
				gesture: "Dragging one filled seed onto another creates a new live patch from the pair.",
				body: "Drag the upper-left seed onto the lower-left seed. A curved thread and double bloom show the target. Release to breed, then listen to the new combination.",
				detail: "Both parent memories survive. Recall either one to compare, or Shift-click an unused seed to store the child. This changes the live cables, not the hand controls, saved parents or recorded audio.",
				items: [[\tideBreed, "filled seeds / breed", nil, [[\seed, 0], [\seed, 2]]]]),
			(id: \weather, title: "grow and thin the patch", side: 1,
				gesture: "The moon also has held weather gestures: down grows cables; up thins them.",
				body: "Drag the moon down and hold briefly for rain, then release. Try upward for sun. More travel increases the pace. Listen as relationships appear or fall away.",
				detail: "These edit your current patch; a tap instead sows a new random one. Recall a seed to return to your Organ patch. Ctrl+Z / Ctrl+X undo and redo committed patch changes, not audio.",
				items: [[\moon, "down / grow", \down, [[\moon]]],
					[\moon, "up / thin", \up, [[\moon]]]]),
			(id: \drawer, title: "beyond the playing surface", side: 1, concept: true,
				gesture: "Drawer holds precise setup and tools that do not need permanent controls on Night.",
				body: "Inspector shows every cable as a matrix. Workshop holds converter Bits, clip/Wrap, smooth/stair-step playback, source-slot gains and pan. Spellbook records patch edits; Audio holds devices and levels.",
				detail: "Lower Bits makes the next writing rougher; Wrap folds overload instead of clipping it. They matter when the heart writes. Smooth playback can soften an already held loop. Continue once more before opening Drawer, which closes this guide.",
				items: [[\drawer, "Drawer / workbench", nil, [[\ui, \drawer]]]]),
			(id: \finish, title: "save the patch, keep the sound", side: 1, concept: true,
				gesture: "A saved patch and an audio recording preserve different things.",
				body: "After closing this guide, open Drawer > memory, name a snapshot and save it. Unlike the four cable seeds, a snapshot also remembers control settings. Saved snapshots survive a fresh session; neither restores loop audio.",
				detail: "To keep the sound itself, use session REC or R to record the stereo output, then stop it to finish the file. Explore the two voices from here; info cards and Shortcuts remain available whenever you need them.",
				items: [[\drawer, "Memory / save patch", nil, [[\ui, \drawer]]],
					[\rec, "REC / save sound", nil, [[\master, \rec]]]])
		]
	}
}
