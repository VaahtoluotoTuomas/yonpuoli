# machine-specific (CLAUDE.md: no absolute paths in the repo)
config.scd
# Personal agent settings: hold local tool permissions and machine paths.
# The repo must protect itself — a global ~/.config/git/ignore only covers
# this machine, never a fresh clone.
.claude/settings.local.json
*.audio.scd
*.audio.scd.pending
*.audio.scd.bak
tests/dev_paths.scd
tests/sclang_conf_dev.yaml

# audio material and output
samples/
recordings/
tests/tmp/

# Archipelago GUI runtime state (not a user preset)
/presets/compass.cqcompass.scd

# Legacy snapshot location: still read for compatibility, never written.
/presets/*.cqsnap.scd

# Session snapshots: CQ.snap writes these while playing — personal state, not
# repo material. Only the exact documented release bank below is versioned.
/snapshots/*.cqsnap.scd
!/snapshots/example.cqsnap.scd
!/snapshots/undertow.cqsnap.scd
!/snapshots/dust_bloom.cqsnap.scd
!/snapshots/glass_tide.cqsnap.scd
!/snapshots/organ_lanterns.cqsnap.scd
